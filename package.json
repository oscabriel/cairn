{
  "name": "cairn",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint && lefthook install",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p . && pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "check": "oxfmt --check && oxlint && pnpm typecheck && pnpm test",
    "fix": "oxlint --fix && oxfmt",
    "deploy": "alchemy deploy",
    "plan": "alchemy plan",
    "destroy": "alchemy destroy",
    "dev": "node tools/dev.ts"
  },
  "dependencies": {
    "@cairn/client-logic": "workspace:*",
    "@cairn/protocol": "workspace:*",
    "@earendil-works/chord": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-durable": "catalog:",
    "@earendil-works/pi-mcp": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "0.55.0",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "happy-dom": "catalog:",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "playwright": "1.64.1",
    "typescript": "catalog:",
    "ultracite": "8.0.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.11.0"
  },
  "packageManager": "pnpm@10.30.3"
}
