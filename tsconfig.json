{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // Tool configs (oxlint, oxfmt) are validated by the tools that load them; ultracite's
  // preset types don't satisfy exactOptionalPropertyTypes.
  "include": [
    "alchemy.run.ts",
    "apps/web/vite.config.ts",
    "apps/web/vitest.config.ts",
    "judges",
    "ops",
    "stacks",
    "tools/*.ts",
    "vitest.config.ts"
  ]
}
